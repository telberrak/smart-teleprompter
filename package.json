{
  "name": "smart-teleprompter",
  "version": "0.1.0",
  "private": true,
  "description": "Offline teleprompter that follows your voice, records by sentence and cuts the video for you.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "web": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "roughjs": "4.6.6"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "electron": "45.2.3",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wait-on": "9.5.1"
  },
  "optionalDependencies": {
    "@fugood/node-whisper-darwin-arm64": "1.1.3",
    "@fugood/node-whisper-darwin-x64": "1.1.3",
    "@fugood/node-whisper-linux-x64": "1.1.3",
    "@fugood/node-whisper-win32-x64": "1.1.3"
  }
}
